<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="vn_address_convert_view_form" model="ir.ui.view">
        <field name="name">vn.address.convert.form</field>
        <field name="model">vn.address.convert</field>
        <field name="arch" type="xml">
            <form string="Update Vietnamese addresses">
                <p class="text-muted">
                    Since 1 July 2025 an address in Vietnam is a ward and a province, without district.
                    Check the new ward found for each contact, pick one when the old ward was split,
                    then apply. The previous address is kept in each contact's chatter.
                </p>
                <div class="alert alert-info" role="alert" invisible="remaining == 0">
                    <field name="remaining" class="oe_inline"/> more addresses will be listed the next time you open this tool.
                </div>
                <field name="line_ids" nolabel="1">
                    <list editable="bottom" create="0" delete="0"
                          decoration-muted="status == 'not_found'" decoration-warning="status == 'choose'">
                        <field name="apply" nolabel="1" widget="boolean_toggle"/>
                        <field name="partner_id" force_save="1"/>
                        <field name="old_address" force_save="1"/>
                        <field name="status" force_save="1" widget="badge"
                               decoration-success="status == 'found'" decoration-warning="status == 'choose'"/>
                        <field name="candidate_ids" force_save="1" widget="many2many_tags"
                               invisible="status != 'choose'"/>
                        <field name="city_id" options="{'no_create': True, 'no_open': True}"
                               domain="[('vn_code', '!=', False)]"/>
                        <field name="street"/>
                        <field name="street2" optional="show"/>
                    </list>
                </field>
                <footer>
                    <button name="action_apply" type="object" string="Apply" class="btn-primary" data-hotkey="q"/>
                    <button special="cancel" string="Cancel" data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_vn_address_convert" model="ir.actions.act_window">
        <field name="name">Update Vietnamese addresses</field>
        <field name="res_model">vn.address.convert</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'dialog_size': 'extra-large'}</field>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_view_types">list,form</field>
        <field name="group_ids" eval="[Command.link(ref('base.group_partner_manager'))]"/>
    </record>

    <menuitem id="menu_vn_address_convert"
              action="action_vn_address_convert"
              parent="contacts.res_partner_menu_config"
              groups="base.group_partner_manager"
              sequence="90"/>
</odoo>
