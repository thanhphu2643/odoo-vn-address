<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_country_state_tree" model="ir.ui.view">
        <field name="name">res.country.state.tree.vn</field>
        <field name="model">res.country.state</field>
        <field name="inherit_id" ref="base.view_country_state_tree"/>
        <field name="arch" type="xml">
            <field name="country_id" position="after">
                <field name="vn_code" optional="hide"/>
                <field name="vn_replaced" optional="hide"/>
            </field>
        </field>
    </record>

    <record id="view_city_tree" model="ir.ui.view">
        <field name="name">res.city.tree.vn</field>
        <field name="model">res.city</field>
        <field name="inherit_id" ref="base_address_extended.view_city_tree"/>
        <field name="arch" type="xml">
            <field name="zipcode" position="after">
                <field name="vn_code" optional="hide"/>
            </field>
        </field>
    </record>
</odoo>
